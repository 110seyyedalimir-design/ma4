# ═══════════════════════════════════════════════════════════════════════════
#  نمونهٔ متغیرهای محیطی — فقط برای تست روی کامپیوتر خودت (docker run --env-file .env)
#  ⚠️ این فایل را هرگز در ریپوی public کامیت نکن (در .gitignore هست).
#  روی GitHub Actions، این مقادیر را در Secrets / Variables ریپو بگذار، نه در فایل.
# ═══════════════════════════════════════════════════════════════════════════

# ── مشترک ────────────────────────────────────────────────────────────────
TG_API_ID=
TG_API_HASH=
HF_TOKEN=                              # توکن Write از huggingface.co/settings/tokens
DATA_REPO=yourname/bot-data            # مخزن خصوصی dataset برای داده‌های ربات ۱
DOR_DATA_REPO=yourname/dorbargardoon-data
PERSIST_SECONDS=30                     # هر چند ثانیه داده‌ها ذخیره شود
PORT=7860

# ── ربات ۱: آچارفرانسه ───────────────────────────────────────────────────
BOT_TOKEN=                             # از @BotFather
ADMIN_IDS=                             # آیدی عددی مدیران، جدا با کاما
AI_API_KEY=                            # اختیاری (کلید هوش مصنوعی)
# USERBOT_ENABLED=1
# AGENT_ENABLED=1
# SDSEND_ENABLED=1

# ── ربات ۲: دوربرگردون ───────────────────────────────────────────────────
DOR_BOT_TOKEN=
DOR_ADMIN_ID=
LICENSE_PRIVATE_KEY=
PUBLIC_URL=                            # آدرس عمومی HTTPS (بیرون از HF اجباری است)
# IOS_PUBLIC_URL=
# DATA_DIR=/data
# MODE=polling
# KEEPALIVE_MINUTES=5

# ── سوئیچ‌های run_all.py ──────────────────────────────────────────────────
ENABLE_BOT1=1
ENABLE_BOT2=0                          # روی GitHub Actions بدون تانل Cloudflare = 0
